#!/bin/bash
#SBATCH -J aigfs_prep_%CYC%
#SBATCH -p compute
#SBATCH -t 00:30:00
###SBATCH -A %PROJ%-%PROJENVIR%
#SBATCH --nodes=1
#SBATCH --tasks=1
#SBATCH --mem=10GB
#SBATCH -v

export model=aigfs

export HOMEaigfs=/lfs/work/russell_manser/software/aigfs.nimbus
source ${HOMEaigfs}/versions/run.ver
#%include <head.h>
#%include <envir-p1.h>

#export cyc=%CYC%

module use /lfs/work/alexander_richert/stack/spack-stack/envs/nco-sci-intel-2021.10.0/modules_flat/Core

source /opt/intel/oneapi/modulefiles-setup.sh --force
module load wgrib2/${wgrib2_ver:?}
module load libjpeg/${libjpeg_ver:?}

source ${HOMEaigfs}/venv/bin/activate

module list

echo "${HOMEaigfs}/jobs/JAIGFS_PREP"

if [[ $? -ne 0 ]]; then
    ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT"
    ecflow_client --abort
    exit
fi

#%include <tail.h>
#%manual
###############################################################################
#
#  PURPOSE: Prepare data for running a machine learning model with GFS inputs
#
###############################################################################
#%end
